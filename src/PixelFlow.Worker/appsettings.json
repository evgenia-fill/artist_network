{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JobProcessing": {
    "MaxAttempts": 3,
    "LeaseSeconds": 120,
    "RetryInitialDelaySeconds": 5,
    "RecoveryIntervalSeconds": 15,
    "PendingReplayAfterSeconds": 30,
    "RecoveryBatchSize": 100
  }
}
